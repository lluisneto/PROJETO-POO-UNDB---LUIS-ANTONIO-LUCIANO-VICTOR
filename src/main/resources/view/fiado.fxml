<?xml version="1.0" encoding="UTF-8"?>

<!--
  Tela Fiado. À esquerda: as contas (quem deve mais primeiro). À direita: a conta selecionada
  (saldo, uso do limite, histórico e registrar pagamento). Embaixo: o total a receber.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.controleagil.controller.FiadoController"
      styleClass="tela" spacing="16">

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <!-- ===== Contas ===== -->
        <VBox spacing="16" HBox.hgrow="ALWAYS">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <CheckBox fx:id="somenteQuemDeve" text="Mostrar só quem deve"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resumoLista" styleClass="dica"/>
            </HBox>
            <!-- "&#10;" é uma quebra de linha: os títulos compridos ficam em duas linhas -->
            <TableView fx:id="tabelaContas" VBox.vgrow="ALWAYS" styleClass="cabecalho-duplo">
                <columns>
                    <TableColumn fx:id="colunaCliente" text="Cliente" prefWidth="170"/>
                    <TableColumn fx:id="colunaLimite" text="Limite" prefWidth="90" minWidth="88" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaSaldo" text="Saldo&#10;devedor" prefWidth="100" minWidth="88" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaCredito" text="Crédito&#10;disponível" prefWidth="100" minWidth="88" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaUltimaCompra" text="Última&#10;compra" prefWidth="100" minWidth="92"/>
                </columns>
                <placeholder>
                    <Label text="Nenhuma conta fiado. Abra uma conta na tela Clientes." styleClass="dica"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ===== Conta selecionada ===== -->
        <VBox styleClass="painel" spacing="8" prefWidth="380" minWidth="320">
            <Label fx:id="nomeCliente" styleClass="secao-titulo" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="semSelecao" styleClass="dica" wrapText="true"
                   text="Selecione uma conta na tabela para ver o saldo, o histórico e registrar pagamentos."/>

            <VBox fx:id="detalhesConta" spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Saldo devedor" styleClass="rotulo"/>
                <Label fx:id="saldoDevedor" styleClass="valor-destaque"/>
                <Label fx:id="devendoDesde" styleClass="dica"/>
                <ProgressBar fx:id="barraLimite" styleClass="barra-limite" maxWidth="Infinity"/>
                <Label fx:id="textoLimite" styleClass="dica" wrapText="true" minHeight="-Infinity"/>

                <Separator/>
                <Label text="Histórico" styleClass="secao-titulo"/>
                <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS" minHeight="120" prefHeight="160"
                           styleClass="cabecalho-duplo">
                    <columns>
                        <TableColumn fx:id="colunaData" text="Data" prefWidth="96" minWidth="88"/>
                        <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="96"/>
                        <TableColumn fx:id="colunaValor" text="Valor" prefWidth="90" minWidth="84" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaPedido" text="Pedido&#10;nº" prefWidth="72"/>
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma movimentação ainda." styleClass="dica"/>
                    </placeholder>
                </TableView>

                <Label text="Registrar pagamento" styleClass="secao-titulo"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="campoValorPagamento" promptText="Valor, ex.: 50,00" HBox.hgrow="ALWAYS"/>
                    <Button text="Registrar" onAction="#registrarPagamento" styleClass="botao-primario"/>
                </HBox>
                <Label fx:id="mensagemErro" styleClass="erro-campo" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- ===== Total a receber ===== -->
    <HBox styleClass="rodape-total" spacing="16" alignment="CENTER_LEFT">
        <Label text="Total a receber no fiado" styleClass="rotulo"/>
        <Label fx:id="totalAReceber" styleClass="valor-grande"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resumoDevedores" styleClass="dica"/>
    </HBox>
</VBox>
