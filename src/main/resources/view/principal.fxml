<?xml version="1.0" encoding="UTF-8"?>

<!--
  Janela principal do Controle Ágil.
  Em cima: a marca, a navegação em pílulas (uma pílula por tela) e a data.
  Embaixo dela: o título da tela aberta e a tela em si (o PrincipalController troca só o centro).
  Por cima de tudo, no canto de baixo: a mensagem rápida que aparece depois de salvar algo e some sozinha.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.controleagil.controller.PrincipalController">
<BorderPane styleClass="janela">

    <!-- ===== Barra do topo ===== -->
    <top>
        <HBox styleClass="barra-topo" alignment="CENTER_LEFT" spacing="16">
            <HBox alignment="CENTER_LEFT" spacing="12" minWidth="-Infinity">
                <StackPane styleClass="marca-logo">
                    <Label text="LS"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT">
                    <Label text="Controle Ágil" styleClass="marca-nome"/>
                    <Label text="L Salgados Distribuidora" styleClass="marca-cliente"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="nav" alignment="CENTER" minWidth="-Infinity">
                <Button fx:id="botaoInicio" text="Início" styleClass="botao-menu" minWidth="-Infinity"/>
                <Button fx:id="botaoAgenda" text="Agenda do dia" styleClass="botao-menu" minWidth="-Infinity"/>
                <Button fx:id="botaoNovoPedido" text="Novo pedido" styleClass="botao-menu" minWidth="-Infinity"/>
                <Button fx:id="botaoClientes" text="Clientes" styleClass="botao-menu" minWidth="-Infinity"/>
                <Button fx:id="botaoProdutos" text="Produtos" styleClass="botao-menu" minWidth="-Infinity"/>
                <Button fx:id="botaoFiado" text="Fiado" styleClass="botao-menu" minWidth="-Infinity"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dataHoje" styleClass="data-hoje" minWidth="-Infinity"/>
        </HBox>
    </top>

    <!-- ===== Área de conteúdo ===== -->
    <center>
        <BorderPane fx:id="areaConteudo" styleClass="area-conteudo">
            <top>
                <HBox styleClass="cabecalho" alignment="BASELINE_LEFT" spacing="10">
                    <Label fx:id="tituloTela" styleClass="titulo-tela"/>
                    <Label fx:id="tituloTelaCinza" styleClass="titulo-tela-cinza"/>
                </HBox>
            </top>
            <!-- O centro é preenchido pelo PrincipalController com a tela escolhida na navegação. -->
        </BorderPane>
    </center>
</BorderPane>

    <!-- Mensagem rápida (ex.: "Pedido nº 12 salvo"): flutua no canto de baixo e some sozinha -->
    <Label fx:id="mensagemStatus" styleClass="mensagem-status" mouseTransparent="true"
           StackPane.alignment="BOTTOM_LEFT">
        <StackPane.margin><Insets left="40" bottom="40"/></StackPane.margin>
    </Label>
</StackPane>
