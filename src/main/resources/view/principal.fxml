<?xml version="1.0" encoding="UTF-8"?>

<!--
  Janela principal do Controle Ágil.
  À esquerda, o menu (fundo escuro). À direita, a área de conteúdo: cabeçalho em cima,
  a tela escolhida no centro (o PrincipalController troca só esse centro) e a barra de status embaixo.

  Os ícones são desenhados com SVGPath (caminhos dos Material Icons do Google, licença Apache 2.0),
  para não precisar de nenhuma biblioteca extra nem de arquivos de imagem.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.controleagil.controller.PrincipalController"
            styleClass="janela">

    <!-- ===== Menu lateral ===== -->
    <left>
        <VBox styleClass="menu-lateral" prefWidth="230" minWidth="230" spacing="4">
            <VBox styleClass="marca" spacing="2">
                <Label text="Controle Ágil" styleClass="marca-nome"/>
                <Label text="A L Salgados Distribuidora" styleClass="marca-cliente"/>
            </VBox>

            <Label text="PEDIDOS" styleClass="menu-secao"/>
            <Button fx:id="botaoInicio" text="Início" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu" content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </graphic>
            </Button>
            <Button fx:id="botaoAgenda" text="Agenda do dia" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu"
                             content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
                </graphic>
            </Button>
            <Button fx:id="botaoNovoPedido" text="Novo pedido" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu" content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </graphic>
            </Button>

            <Label text="CADASTROS" styleClass="menu-secao"/>
            <Button fx:id="botaoClientes" text="Clientes" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu"
                             content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                </graphic>
            </Button>
            <Button fx:id="botaoProdutos" text="Produtos" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu"
                             content="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/>
                </graphic>
            </Button>

            <Label text="FINANCEIRO" styleClass="menu-secao"/>
            <Button fx:id="botaoFiado" text="Fiado" styleClass="botao-menu" maxWidth="Infinity">
                <graphic>
                    <SVGPath styleClass="icone-menu"
                             content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Etapa 1 · dados de exemplo em memória" styleClass="menu-rodape" wrapText="true"/>
        </VBox>
    </left>

    <!-- ===== Área de conteúdo ===== -->
    <center>
        <BorderPane fx:id="areaConteudo" styleClass="area-conteudo">
            <top>
                <HBox styleClass="cabecalho" alignment="BASELINE_LEFT" spacing="16">
                    <Label fx:id="tituloTela" styleClass="titulo-tela"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="dataHoje" styleClass="data-hoje"/>
                </HBox>
            </top>
            <!-- O centro é preenchido pelo PrincipalController com a tela escolhida no menu. -->
            <bottom>
                <HBox styleClass="barra-status" alignment="CENTER_LEFT">
                    <Label fx:id="mensagemStatus" styleClass="mensagem-status"/>
                </HBox>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>
