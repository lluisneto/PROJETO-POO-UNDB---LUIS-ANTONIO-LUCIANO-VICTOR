<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.controleagil.controller.ClientesController">
    <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>

    <Label text="Clientes" styleClass="titulo"/>

    <GridPane styleClass="cartao" hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nome *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNome" promptText="Nome do cliente" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Telefone" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoTelefone" promptText="(98) 90000-0000" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Endereço" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoEndereco" promptText="Rua, número e bairro" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <CheckBox fx:id="caixaFiado" text="Abrir conta fiado" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoLimite" promptText="Limite em reais, ex.: 100,00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <Button text="Salvar cliente" onAction="#salvar" defaultButton="true" styleClass="primario"/>
            <Button text="Limpar" onAction="#limparCampos"/>
        </HBox>
    </GridPane>

    <Label fx:id="mensagem" styleClass="mensagem" wrapText="true"/>

    <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Nenhum cliente cadastrado ainda."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colunaNome" text="Nome" prefWidth="220"/>
            <TableColumn fx:id="colunaTelefone" text="Telefone" prefWidth="150"/>
            <TableColumn fx:id="colunaEndereco" text="Endereço" prefWidth="280"/>
            <TableColumn fx:id="colunaFiado" text="Fiado" prefWidth="170"/>
        </columns>
    </TableView>
</VBox>
