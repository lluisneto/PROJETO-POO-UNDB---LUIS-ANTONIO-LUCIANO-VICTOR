<?xml version="1.0" encoding="UTF-8"?>

<!--
  Tela Início (painel): 4 cartões com os números do dia e a lista das próximas entregas.
  Os textos com fx:id são preenchidos pelo InicioController.
  Os cartões ficam num TilePane ("ladrilhos"): em janela larga, 4 numa linha; em janela estreita,
  2 por linha (o InicioController decide), para os números nunca serem cortados.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.controleagil.controller.InicioController"
      styleClass="tela" spacing="24">

    <!-- ===== Cartões ===== -->
    <TilePane fx:id="cartoes" hgap="16" vgap="16" prefColumns="4">
        <VBox styleClass="cartao" spacing="8" maxWidth="Infinity">
            <Label text="Pedidos de hoje" styleClass="cartao-titulo"/>
            <Label fx:id="numeroPedidosHoje" styleClass="cartao-numero"/>
            <Label fx:id="detalhePedidosHoje" styleClass="cartao-detalhe"/>
        </VBox>
        <VBox styleClass="cartao, cartao-destaque" spacing="8" maxWidth="Infinity">
            <Label text="Próximas 2 horas" styleClass="cartao-titulo"/>
            <Label fx:id="numeroProximasHoras" styleClass="cartao-numero"/>
            <Label fx:id="detalheProximasHoras" styleClass="cartao-detalhe"/>
        </VBox>
        <VBox styleClass="cartao" spacing="8" maxWidth="Infinity">
            <Label text="A receber no fiado" styleClass="cartao-titulo"/>
            <Label fx:id="valorAReceber" styleClass="cartao-numero"/>
            <Label fx:id="detalheAReceber" styleClass="cartao-detalhe"/>
        </VBox>
        <VBox styleClass="cartao" spacing="8" maxWidth="Infinity">
            <Label text="Clientes devendo" styleClass="cartao-titulo"/>
            <Label fx:id="numeroDevedores" styleClass="cartao-numero"/>
            <Label fx:id="detalheDevedores" styleClass="cartao-detalhe"/>
        </VBox>
    </TilePane>

    <!-- ===== Próximas entregas ===== -->
    <VBox styleClass="painel" spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Próximas entregas" styleClass="secao-titulo"/>
                <Label text="Pedidos de hoje que ainda não foram finalizados, por horário. Clique para abrir a agenda."
                       styleClass="dica" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Button text="Abrir agenda do dia" onAction="#abrirAgenda" minWidth="-Infinity"/>
            <Button text="Novo pedido" onAction="#abrirNovoPedido" styleClass="botao-primario" minWidth="-Infinity"/>
        </HBox>
        <VBox fx:id="listaEntregas" spacing="8"/>
        <Label fx:id="semEntregas" text="Nenhuma entrega pendente para hoje." styleClass="estado-vazio-titulo"
               visible="false" managed="false"/>
    </VBox>
</VBox>
