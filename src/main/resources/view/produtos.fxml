<?xml version="1.0" encoding="UTF-8"?>

<!--
  Tela Produtos. À esquerda: a tabela. À direita: formulário de cadastro/edição e a dica sobre o preço da época.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.controleagil.controller.ProdutosController"
      styleClass="tela" spacing="16">

    <!-- ===== Lista ===== -->
    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <Label fx:id="resumoLista" styleClass="dica"/>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colunaNome" text="Nome" prefWidth="420"/>
                <TableColumn fx:id="colunaPreco" text="Preço" prefWidth="150" styleClass="coluna-numero"/>
            </columns>
            <placeholder>
                <Label text="Nenhum produto cadastrado." styleClass="dica"/>
            </placeholder>
        </TableView>
    </VBox>

    <!-- ===== Formulário ===== -->
    <VBox styleClass="painel" spacing="8" prefWidth="320" minWidth="290">
        <Label fx:id="tituloFormulario" styleClass="secao-titulo"/>
        <Label text="Nome *" styleClass="rotulo"/>
        <TextField fx:id="campoNome" promptText="ex.: Coxinha de frango"/>
        <Label text="Preço (R$) *" styleClass="rotulo"/>
        <TextField fx:id="campoPreco" promptText="ex.: 5,50"/>
        <Label fx:id="textoPrecoAtual" styleClass="dica"/>
        <Label fx:id="mensagemErro" styleClass="erro-campo" wrapText="true" minHeight="-Infinity"/>
        <Button fx:id="botaoSalvar" text="Cadastrar" onAction="#salvar" styleClass="botao-primario" maxWidth="Infinity"/>
        <Button text="Novo produto" onAction="#novoProduto" maxWidth="Infinity"/>

        <!-- Explica a decisão do "preço da época" (ItemPedido guarda o seu próprio preço) -->
        <VBox styleClass="dica-caixa" spacing="8">
            <Label text="Mudou o preço?" style="-fx-font-weight: bold;"/>
            <Label wrapText="true" minHeight="-Infinity"
                   text="O preço novo vale para os próximos pedidos. Os pedidos antigos mantêm o preço da época: cada item guardou o preço do dia em que foi vendido."/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="* campos obrigatórios" styleClass="dica"/>
    </VBox>
</HBox>
