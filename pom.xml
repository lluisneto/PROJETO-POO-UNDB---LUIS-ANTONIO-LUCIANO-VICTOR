<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.controleagil</groupId>
    <artifactId>controle-agil</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Controle Ágil</name>
    <description>Gestão de pedidos agendados e controle de fiado para a A L Salgados Distribuidora</description>

    <properties>
        <!-- Compila para o Java 21 (LTS), mesmo que a máquina tenha um JDK mais novo -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões num lugar só: para atualizar, troque aqui -->
        <javafx.version>21.0.13</javafx.version>
        <!-- 3.47+ trata o slf4j como opcional no module-info; a 3.46 exigia o slf4j e quebrava os módulos -->
        <sqlite.version>3.54.1.0</sqlite.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- Telas (JavaFX): controles (botões, tabelas...) e FXML (telas descritas em XML) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Banco de dados local (SQLite): os repositórios em repository/sqlite guardam os dados
             do sistema no arquivo controle-agil.db. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Testes automatizados -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
            <!-- Abre o sistema com: .\mvnw.cmd javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- módulo/classe: o sistema usa módulos Java (veja module-info.java) -->
                    <mainClass>br.com.controleagil/br.com.controleagil.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
